  "biomes": [
    {
      "key": "forest",
      "name": {
        "fr": "Forêt",
        "en": "Forest"
      },
      "description": {
        "fr": "Des bois malades où les arbres pourrissent sur pied. Quelques plantes survivent encore à l'ombre des troncs morts.",
        "en": "Sickly woods where trees rot where they stand. A few plants still survive in the shade of the dead trunks."
      },
      "realm": "mortal"
    },
    {
      "key": "swamp",
      "name": {
        "fr": "Marais",
        "en": "Swamp"
      },
      "description": {
        "fr": "Des eaux stagnantes et fétides, où seul ce qui aime la mort prospère.",
        "en": "Stagnant, fetid waters where only what loves death thrives."
      },
      "realm": "mortal"
    },
    {
      "key": "mountains",
      "name": {
        "fr": "Montagnes",
        "en": "Mountains"
      },
      "description": {
        "fr": "Des pentes nues balayées par un vent de cendre. La roche garde ses filons, pour qui sait les trouver.",
        "en": "Bare slopes swept by an ash-laden wind. The rock keeps its veins, for those who can find them."
      },
      "realm": "mortal"
    },
    {
      "key": "caves",
      "name": {
        "fr": "Souterrains",
        "en": "Underground"
      },
      "description": {
        "fr": "Cavernes, galeries et mines abandonnées. Dans le noir, la fin du monde semble encore loin.",
        "en": "Caves, tunnels and abandoned mines. In the dark, the end of the world still seems far away."
      },
      "realm": "mortal"
    },
    {
      "key": "plains",
      "name": {
        "fr": "Plaines et landes",
        "en": "Plains and moors"
      },
      "description": {
        "fr": "Des champs brûlés et des landes grises où les herbes folles reprennent ce que les hommes ont abandonné.",
        "en": "Burnt fields and grey moors where weeds take back what people left behind."
      },
      "realm": "mortal"
    },
    {
      "key": "ruins",
      "name": {
        "fr": "Ruines et cimetières",
        "en": "Ruins and graveyards"
      },
      "description": {
        "fr": "Villages pillés et tombes ouvertes. On n'y cueille rien : on y fouille ce que les morts ont laissé.",
        "en": "Looted villages and open graves. Nothing is picked here: you search through what the dead left behind."
      },
      "realm": "mortal"
    },
    {
      "key": "coast",
      "name": {
        "fr": "Côtes et rivières",
        "en": "Coasts and rivers"
      },
      "description": {
        "fr": "Berges boueuses et grèves grises, où l'eau charrie plus de débris que de vie.",
        "en": "Muddy banks and grey shores, where the water carries more debris than life."
      },
      "realm": "mortal"
    },
    {
      "key": "faerie",
      "realm": "hidden",
      "name": {
        "fr": "Royaumes cachés",
        "en": "Hidden Kingdoms"
      },
      "description": {
        "fr": "Les terres où les fées se sont enfuies. Tout y pousse encore, mais rien n'y est gratuit, et le temps n'y passe pas comme ailleurs.",
        "en": "The lands the fey fled to. Everything still grows there, but nothing comes free, and time does not pass as it does elsewhere."
      }
    },
    {
      "key": "underworld",
      "realm": "underworld",
      "name": {
        "fr": "Royaume des morts",
        "en": "Underworld"
      },
      "description": {
        "fr": "Le domaine des ombres, gardé pour que nul vivant n'y entre. Ce qu'on y trouve a le froid de la mort.",
        "en": "The domain of the shades, guarded so that no living being enters. What is found there carries the chill of death."
      }
    },
    {
      "key": "hell",
      "realm": "hell",
      "name": {
        "fr": "Fosses de l'Enfer",
        "en": "Pits of Hell"
      },
      "description": {
        "fr": "Les fosses où les diables tourmentent les damnés. Y mettre le pied, c'est inviter la corruption.",
        "en": "The pits where devils torment the damned. Setting foot there invites corruption."
      }
    },
    {
      "key": "void",
      "realm": "void",
      "name": {
        "fr": "Épaves du Vide",
        "en": "Wrecks of the Void"
      },
      "description": {
        "fr": "Des débris de réalités détruites dérivant dans les ténèbres glacées, hantés par les démons.",
        "en": "Debris of destroyed realities drifting in the frozen dark, haunted by demons."
      }
    }
  ],
